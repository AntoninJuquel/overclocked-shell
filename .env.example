# Copy to .env (gitignored). Values from your Bungie application: https://www.bungie.net/en/Application
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
# Must match the app's Redirect URL; https://localhost or 127.0.0.1 only.
# BUNGIE_REDIRECT_URL=https://localhost:7777/callback
# Language of game names in outputs (a Bungie manifest language, as in DIM): en, fr, de, es, es-mx, it, ja, ko, pl, pt-br, ru, zh-chs, zh-cht
# SHELL_LANGUAGE=en
